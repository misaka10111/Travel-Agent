# DeepSeek（OpenAI 兼容接口）配置，换成你自己的 key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# Tavily 通用网页搜索，去 https://app.tavily.com 生成
TAVILY_API_KEY=tvly-your-key-here

# 餐饮检索：千问仅解析自然语言查询，高德提供餐厅事实数据。
# 仅写入后端 SearchAgent/.env，不要放入前端 VITE_* 变量或提交真实密钥。
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
AMAP_API_KEY=your-amap-web-service-key

# 餐饮 HTTP 服务允许的前端来源，必须是 JSON 数组。
FOOD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
