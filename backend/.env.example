APP_NAME=TravelAgent API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api
DATABASE_URL=sqlite:///./travelagent.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Backend Web service credentials only; never expose through VITE_* variables.
AMAP_WEB_SERVICE_KEY=
GOOGLE_MAPS_API_KEY=
MAP_REQUEST_TIMEOUT_SECONDS=15
# Hard request count ceiling for one explicit probe; no automatic retries.
MAP_PROBE_MAX_CALLS=12

# P1 structured JSON model client; backend only. Compatible Chat Completions URL.
PLANNING_API_KEY=
PLANNING_BASE_URL=https://api.deepseek.com
PLANNING_MODEL=deepseek-flash
PLANNING_MODEL_TIMEOUT_SECONDS=45
PLANNING_MODEL_CALL_LIMIT=20
PLANNING_MAP_CALL_LIMIT=12
PLANNING_STEP_LIMIT=12
PLANNING_RUN_TIMEOUT_SECONDS=180

